# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Primary Supabase Project (Android CGL Hustle)
# Used for User Auth, App State, Saved Quizzes, Analytics
PRIMARY_SUPABASE_URL=https://primary.supabase.co
PRIMARY_SUPABASE_ANON_KEY=dummy_anon_key

# Secondary Supabase Project (GK LLM)
# STRICTLY Read-Only. Used for Question Content Service
GK_LLM_SUPABASE_URL=https://gkllm.supabase.co
GK_LLM_SUPABASE_ANON_KEY=dummy_anon_key
